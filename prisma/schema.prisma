// Prisma Schema for MedBooking / RehabConnect MVP
// International aggregator for clinics, rehab centers, and medical appointments

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Clinic {
  id          String    @id @default(cuid())
  name        String
  description String    @db.Text
  address     String
  city        String
  country     String
  lat         Float
  lng         Float
  rating      Float     @default(0.0)
  reviewCount Int       @default(0)
  images      String[]  // URLs of clinic photos, wards, and amenities
  category    String    // e.g. "Больница", "Рехаб", "Наркология", "Психология", "Ортопедия"
  phone       String?
  email       String?
  website     String?
  minPrice    Float     @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  doctors     Doctor[]
  services    Service[]
  bookings    Booking[]

  @@index([city, country])
  @@index([category])
}

model Doctor {
  id              String    @id @default(cuid())
  clinicId        String
  clinic          Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  fullName        String
  specialty       String    // e.g. "Врач-нарколог, психотерапевт", "Травматолог-ортопед"
  experienceYears Int
  photo           String?
  bio             String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  bookings        Booking[]

  @@index([clinicId])
}

model Service {
  id           String    @id @default(cuid())
  clinicId     String
  clinic       Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  title        String    // e.g. "Комплексный 28-дневный курс реабилитации"
  description  String    @db.Text
  price        Float     // Price in USD or base currency
  durationDays Int       // Inpatient or outpatient duration in days
  category     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  bookings     Booking[]

  @@index([clinicId])
}

model Booking {
  id           String        @id @default(cuid())
  clinicId     String
  clinic       Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctorId     String?
  doctor       Doctor?       @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  serviceId    String?
  service      Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  patientName  String
  patientPhone String
  desiredDate  DateTime
  comment      String?       @db.Text
  status       BookingStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([clinicId])
  @@index([doctorId])
}
