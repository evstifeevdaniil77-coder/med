# Сервер MedBooking API
PORT=5000
NODE_ENV=development

# Telegram Bot интеграция
# 1. Создайте бота в Telegram через @BotFather и получите токен (например, 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# 2. Узнайте ваш Chat ID (или ID группы/канала) через @userinfobot или отправив боту сообщение
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID_HERE

# Разрешенные источники CORS (через запятую или * для всех)
# Разрешаем GitHub Pages, localhost и Vercel
CORS_ORIGIN=https://evstifeevdaniil77-coder.github.io,http://localhost:3000,http://localhost:5000,http://127.0.0.1:5500
